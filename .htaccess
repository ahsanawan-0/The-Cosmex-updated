<IfModule mod_rewrite.c>
    RewriteEngine On

    # One canonical host: www.thecosmex.com -> thecosmex.com (single 301, HTTPS)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

    # Strip trailing slashes HERE, before the request is mapped into public/.
    # (Laravel's own rule in public/.htaccess would otherwise redirect to /public/...)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+?)/+$ /$1 [R=301,L,NE]

    # Serve the Laravel app from public/. Direct /public/... and /index.php
    # requests are 301-redirected to the clean URL by App\Http\Middleware\CanonicalHost.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
